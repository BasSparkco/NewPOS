# Copy this file to `.env` next to docker-compose.staging.yml on the server and fill in real
# values. Never commit the real `.env` — it holds live secrets.

# --- PostgreSQL (internal-only; never exposed on a host port) ---
POSTGRES_DB=pos_staging
POSTGRES_USER=pos_app
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# --- POS.Api ---
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-real-random-secret-at-least-32-chars
# Enables POST /api/platform/tenants (operator-only tenant provisioning). Generate the same way as
# above. Leave blank to keep the endpoint disabled (returns 404 either way to an unauthorized caller).
PLATFORM_PROVISIONING_SECRET=replace-with-an-operator-only-secret
# Set to "true" for exactly one controlled first boot to apply migrations, then set back to
# "false" and redeploy. See docs/STAGING_DEPLOYMENT.md.
API_APPLY_MIGRATIONS_ON_STARTUP=false
# Set to "true" only for the very first boot of a brand-new database to seed baseline demo data.
API_SEED_DEMO_DATA_ON_STARTUP=false

# --- Hostnames (must resolve to this server; *.sparkco.vip already does via wildcard DNS) ---
POS_API_HOSTNAME=pos-api-staging.sparkco.vip
POS_WEB_HOSTNAME=pos-staging.sparkco.vip

# --- Traefik basic auth for the Web dashboard only ---
# Generate with: htpasswd -nB <username>   (or `openssl passwd -apr1`)
# IMPORTANT: docker compose interpolates `$` in .env values, so every literal `$` in the resulting
# hash must be escaped as `$$`, e.g. htpasswd's `$2y$05$...` becomes `$$2y$$05$$...` here.
TRAEFIK_BASIC_AUTH_USERS=admin:$$2y$$05$$replace-with-a-real-bcrypt-hash
