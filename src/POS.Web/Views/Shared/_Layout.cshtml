@using System.Security.Claims
@inject POS.Application.Abstractions.ICurrentSession CurrentSession
@inject POS.Application.Abstractions.IStoreAccessService StoreAccessService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Control Room</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/POS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="shell-frame">
        <header class="shell-header">
            <a class="brand-mark" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark__eyebrow">Stage 5.1</span>
                <span class="brand-mark__title">POS Control Room</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var accessibleStores = await StoreAccessService.GetAccessibleStoresAsync();
                <div class="shell-actions">
                    <a class="shell-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="shell-link" asp-controller="Management" asp-action="Index">Management</a>
                    <a class="shell-link" asp-controller="Stores" asp-action="Index">Stores</a>
                    <a class="shell-link" asp-controller="Audit" asp-action="Index">Audit log</a>
                    <a class="shell-link" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                    @if (accessibleStores.Count > 1)
                    {
                        <form asp-controller="Stores" asp-action="Switch" method="post" class="store-switcher">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <select name="storeId" class="store-switcher__select" onchange="this.form.submit()" aria-label="Active store">
                                @foreach (var store in accessibleStores)
                                {
                                    <option value="@store.Id" selected="@(store.Id == CurrentSession.StoreId ? "selected" : null)">@store.Name</option>
                                }
                            </select>
                        </form>
                    }
                    <div class="user-chip">
                        <span class="user-chip__name">@User.Identity.Name</span>
                        <span class="user-chip__role">@User.FindFirstValue(ClaimTypes.Role)</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="shell-button shell-button--ghost">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <div class="shell-actions">
                    <a class="shell-link" asp-controller="Account" asp-action="Login">Admin sign in</a>
                </div>
            }
        </header>

        <main class="shell-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
