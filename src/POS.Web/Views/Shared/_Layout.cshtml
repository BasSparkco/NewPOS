@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Control Room</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/POS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="shell-frame">
        <header class="shell-header">
            <a class="brand-mark" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark__eyebrow">Stage 5.1</span>
                <span class="brand-mark__title">POS Control Room</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="shell-actions">
                    <a class="shell-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="shell-link" asp-controller="Management" asp-action="Index">Management</a>
                    <a class="shell-link" asp-controller="Audit" asp-action="Index">Audit log</a>
                    <a class="shell-link" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                    <div class="user-chip">
                        <span class="user-chip__name">@User.Identity.Name</span>
                        <span class="user-chip__role">@User.FindFirstValue(ClaimTypes.Role)</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="shell-button shell-button--ghost">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <div class="shell-actions">
                    <a class="shell-link" asp-controller="Account" asp-action="Login">Admin sign in</a>
                </div>
            }
        </header>

        <main class="shell-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
