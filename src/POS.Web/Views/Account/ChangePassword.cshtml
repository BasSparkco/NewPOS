@model POS.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<section class="panel" style="max-width: 480px; margin: 0 auto;">
    <div>
        <span class="eyebrow">Account</span>
        <h1 class="panel-title">Change your password</h1>
        <p class="panel-copy">This changes the password for your own account only.</p>
    </div>

    <form asp-action="ChangePassword" method="post" class="panel-stack">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="shell-button">Save new password</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
