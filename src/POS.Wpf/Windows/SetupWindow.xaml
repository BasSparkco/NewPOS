<Window x:Class="POS.Wpf.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up this register"
        Height="480"
        Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgTertiaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SetupTitleTb" Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="SetupIntroTb" Grid.Row="1" Margin="0,8,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

        <!-- Choice: start fresh vs join -->
        <StackPanel x:Name="ChoicePanel" Grid.Row="2" VerticalAlignment="Top"
                    Visibility="{Binding ShowChoicePanel, Converter={StaticResource BoolToVis}}">
            <Button x:Name="StartFreshBtn" Margin="0,0,0,12" Style="{StaticResource AccentButton}"
                    Command="{Binding StartFreshCommand}" IsEnabled="{Binding IsNotBusy}"/>
            <Button x:Name="ShowJoinBtn" Style="{StaticResource GhostButton}"
                    Command="{Binding ShowJoinCommand}"/>
        </StackPanel>

        <!-- Join form -->
        <StackPanel x:Name="JoinPanel" Grid.Row="2" VerticalAlignment="Top"
                    Visibility="{Binding ShowJoinForm, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="ApiUrlLbl" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PosTextBox}" Margin="0,0,0,10"/>

            <TextBlock x:Name="SlugLbl" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox Text="{Binding BusinessSlug, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PosTextBox}" Margin="0,0,0,10"/>

            <TextBlock x:Name="UsernameLbl" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PosTextBox}" Margin="0,0,0,10"/>

            <TextBlock x:Name="PasswordLbl" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="JoinSubmitBtn" Width="110" Margin="0,0,10,0" Style="{StaticResource AccentButton}"
                        Click="JoinSubmitBtn_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                <Button x:Name="BackBtn" Width="90" Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,16,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
