<Window x:Class="POS.Wpf.Windows.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Log"
        Height="680" Width="1040"
        MinHeight="560" MinWidth="860"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgTertiaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14,18,12">
            <StackPanel>
                <TextBlock x:Name="AuditHeaderTb"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="AuditSubtitleTb"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AuditFromLbl" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="AuditFromDate" Grid.Column="1" Width="150"/>

                <TextBlock x:Name="AuditToLbl" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="AuditToDate" Grid.Column="4" Width="150"/>

                <TextBlock x:Name="AuditActionLbl" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AuditActionFilter"
                          Grid.Column="7"
                          Width="170"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"/>

                <TextBlock x:Name="AuditEntityLbl" Grid.Column="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AuditEntityFilter"
                          Grid.Column="10"
                          Width="170"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"/>

                <Button x:Name="AuditRefreshBtn"
                        Grid.Column="12"
                        Click="Refresh_Click"
                        Style="{StaticResource GhostButton}"
                        Padding="16,8"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12"
                Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0.5"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="AuditGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="{StaticResource BgPrimaryBrush}"
                          RowBackground="{StaticResource BgPrimaryBrush}"
                          AlternatingRowBackground="{StaticResource BgSecondaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="AuditWhenCol" Binding="{Binding WhenLocal, Converter={StaticResource Digits}, ConverterParameter='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                        <DataGridTextColumn x:Name="AuditActorCol" Binding="{Binding Actor}" Width="120"/>
                        <DataGridTextColumn x:Name="AuditActionCol" Binding="{Binding Action}" Width="160"/>
                        <DataGridTextColumn x:Name="AuditEntityCol" Binding="{Binding Entity}" Width="200"/>
                        <DataGridTextColumn x:Name="AuditDetailsCol" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="AuditEmptyText"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="AuditCountText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="AuditCloseBtn"
                        DockPanel.Dock="Right"
                        Width="90"
                        Click="Close_Click"
                        Style="{StaticResource GhostButton}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>