<Window x:Class="POS.Wpf.Windows.CurrencySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Settings"
        Height="760"
        Width="940"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="CurrencyHeaderTb" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrencySubtitleTb" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F7F4EF" BorderBrush="#DDD6CE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrencyStoreLbl" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding StoreName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="CurrencyBaseLbl" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding Currencies}"
                          SelectedItem="{Binding SelectedBaseCurrency}"
                          DisplayMemberPath="DisplayLabel" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F5F8FA" BorderBrush="#D7DEE5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="OperationalHeaderTb" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="OperationalSubtitleTb" Margin="0,4,0,12" Foreground="#666" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="AllowNegativeStockCheck"
                              Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,12"
                              IsChecked="{Binding AllowNegativeStock}" />

                    <TextBlock x:Name="LowStockThresholdLbl" Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Width="180"
                             Margin="0,0,0,8"
                             HorizontalAlignment="Left"
                             Text="{Binding LowStockThresholdText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock x:Name="DefaultTaxPercentLbl" Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="180"
                                 HorizontalAlignment="Left"
                                 Text="{Binding DefaultTaxPercentText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="ReceiptFooterLbl" Grid.Row="3" Margin="0,4,12,0" VerticalAlignment="Top" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             MinHeight="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ReceiptFooterText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock x:Name="ExchangeRatesHeaderTb" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrencyHintTb" Margin="0,4,0,0" Foreground="#78716C" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="CurrenciesGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding Currencies}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="Exchange Rate" Binding="{Binding ExchangeRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N6}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#78716C" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CurrencyCancelBtn" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="CurrencySaveBtn" Width="120" Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>