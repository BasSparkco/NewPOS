<Window x:Class="POS.Wpf.Windows.DeviceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devices"
        Height="600" Width="880"
        MinHeight="500" MinWidth="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgTertiaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="DevicesHeaderTb" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="DevicesSubtitleTb" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0.5"
                    CornerRadius="8"
                    ClipToBounds="True">
                <DataGrid x:Name="DevicesGrid"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          SelectionMode="Single"
                          Background="{StaticResource BgPrimaryBrush}"
                          RowBackground="{StaticResource BgPrimaryBrush}"
                          AlternatingRowBackground="{StaticResource BgSecondaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="DevicesNameCol" Binding="{Binding Name}" Width="*"/>
                        <DataGridCheckBoxColumn x:Name="DevicesEnrolledCol" Binding="{Binding IsEnrolled}" Width="90"/>
                        <DataGridCheckBoxColumn x:Name="DevicesRevokedCol" Binding="{Binding IsRevoked}" Width="90"/>
                        <DataGridCheckBoxColumn x:Name="DevicesThisMachineCol" Binding="{Binding IsCurrentMachine}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Provision / enroll / revoke panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0.5"
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DevicesProvisionHeaderTb" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DevicesProvisionHintTb" Margin="0,4,0,8" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>

                    <TextBlock x:Name="DevicesNameLbl" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PosTextBox}"/>

                    <Button x:Name="DevicesProvisionBtn"
                            Margin="0,12,0,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ProvisionCommand}"/>

                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16"/>

                    <TextBlock x:Name="DevicesRevokeHeaderTb" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DevicesRevokeHintTb" Margin="0,4,0,8" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Button x:Name="DevicesRevokeBtn"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RevokeCommand}"/>

                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16"/>

                    <TextBlock x:Name="DevicesEnrollHeaderTb" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DevicesEnrollHintTb" Margin="0,4,0,8" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding EnrollmentCodeText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PosTextBox}"/>
                    <Button x:Name="DevicesEnrollBtn"
                            Margin="0,8,0,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding EnrollThisMachineCommand}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button x:Name="DevicesCloseBtn"
                    DockPanel.Dock="Right"
                    Width="90"
                    Style="{StaticResource GhostButton}"
                    Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
