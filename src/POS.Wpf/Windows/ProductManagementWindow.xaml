<Window x:Class="POS.Wpf.Windows.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:POS.Wpf.Converters"
        Title="Products &amp; categories"
        Height="800" Width="1220"
        MinHeight="620" MinWidth="1000"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgTertiaryBrush}">

    <Window.Resources>
        <conv:FilePathToImageConverter x:Key="FileToImg"/>
        <conv:StringToInitialsConverter x:Key="ToInitials"/>
        <conv:ImagePathToVisibilityConverter x:Key="HasImageVis"/>
        <conv:ImagePathToVisibilityConverter x:Key="NoImageVis" Inverted="True"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StringToVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="HasTextVis" Inverted="True"/>
        <conv:NullToVisibilityConverter x:Key="NotNullVis"/>
        <conv:ActiveStatusLabelConverter x:Key="ActiveStatusLabel"/>
        <conv:ActiveToggleLabelConverter x:Key="ActiveToggleLabel"/>

        <!-- Compact icon-button used for rail/panel affordances -->
        <Style x:Key="RailIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- ═══ Category rail row ═══ -->
        <DataTemplate x:Key="CategoryRowTemplate">
            <Border Margin="0,1" Padding="10,7" CornerRadius="8" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,9,0" Opacity="0.65">
                        <Path Data="{StaticResource IconTag}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/>
                    </Viewbox>

                    <!-- Display name -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsEditing, Converter={StaticResource InvBoolVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Inline rename box -->
                    <TextBox Grid.Column="1" Style="{StaticResource PosTextBox}" FontSize="12" Padding="6,4"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return"
                                        Command="{Binding DataContext.ConfirmRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape"
                                        Command="{Binding DataContext.CancelRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Count badge -->
                    <Border Grid.Column="2" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="9"
                            Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsEditing, Converter={StaticResource InvBoolVis}}">
                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Rename / delete (only for real categories, not the pinned "All" row) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0"
                                Visibility="{Binding CategoryId, Converter={StaticResource NotNullVis}}">
                        <Button Style="{StaticResource RailIconButton}"
                                Command="{Binding DataContext.BeginRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InvBoolVis}}">
                            <Viewbox Width="11" Height="11"><Path Data="{StaticResource IconPencil}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource RailIconButton}" Margin="2,0,0,0"
                                Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InvBoolVis}}">
                            <Viewbox Width="11" Height="11"><Path Data="{StaticResource IconTrash}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource RailIconButton}"
                                Command="{Binding DataContext.ConfirmRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="12" Height="12"><Path Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource RailIconButton}" Margin="2,0,0,0"
                                Command="{Binding DataContext.CancelRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="11" Height="11"><Path Data="{StaticResource IconX}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ Product row ═══ -->
        <DataTemplate x:Key="ProductRowTemplate">
            <Grid MinHeight="60" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                        Background="{DynamicResource AccentLightBrush}"
                        ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Name, Converter={StaticResource ToInitials}}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ImagePath, Converter={StaticResource NoImageVis}}"/>
                        <Image Stretch="UniformToFill"
                               Source="{Binding ImagePath, Converter={StaticResource FileToImg}}"
                               Visibility="{Binding ImagePath, Converter={StaticResource HasImageVis}}"/>
                    </Grid>
                </Border>

                <!-- Name + barcode -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Barcode}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding Barcode, Converter={StaticResource HasTextVis}}"/>
                </StackPanel>

                <!-- Category chip -->
                <Border Grid.Column="3" Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0.5"
                        CornerRadius="10" Padding="9,3" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- Price -->
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Price, Converter={StaticResource Digits}, ConverterParameter=N2}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Qty + low-stock dot -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource WarnBrush}" Margin="0,0,5,0"
                             Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding QuantityOnHand, Converter={StaticResource Digits}, ConverterParameter=N0}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Status pill -->
                <Border Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="9" Padding="8,2"
                        Visibility="{Binding IsActive, Converter={StaticResource InvBoolVis}}"
                        Background="{DynamicResource BgTertiaryBrush}">
                    <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveStatusLabel}}"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ═══ Activity feed row ═══ -->
        <DataTemplate x:Key="ActivityRowTemplate">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding QuantityDelta, Converter={StaticResource Digits}, ConverterParameter='+0.##;-0.##;0'}"/>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                    <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding CreatedAt, Converter={StaticResource Digits}, ConverterParameter='{}{0:MMM d, HH:mm}'}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ═══ Product list row chrome (selection/hover) ═══ -->
        <Style x:Key="ProductRowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBdr" Background="Transparent"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,0.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBdr" Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBdr" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="HeaderTitleTb" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                        Command="{Binding AddProductCommand}" Padding="16,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconPlus}" Fill="White" Stretch="Fill"/>
                        </Viewbox>
                        <TextBlock x:Name="AddProductBtnTb" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ─── CATEGORIES RAIL ─── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0.5" CornerRadius="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
                        <TextBlock x:Name="CategoriesHeaderTb" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="AddCategoryIconBtn" Style="{StaticResource RailIconButton}"
                                HorizontalAlignment="Right" Command="{Binding ToggleAddCategoryCommand}">
                            <Viewbox Width="12" Height="12">
                                <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource AccentBrush}" Stretch="Fill"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Inline add-category row -->
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,10"
                          Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewCategoryBox" Grid.Column="0" Style="{StaticResource PosTextBox}"
                                 Padding="8,6" FontSize="12"
                                 Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding ToggleAddCategoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource RailIconButton}" Margin="4,0,0,0"
                                Command="{Binding AddCategoryCommand}">
                            <Viewbox Width="12" Height="12"><Path Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource RailIconButton}" Margin="2,0,0,0"
                                Command="{Binding ToggleAddCategoryCommand}">
                            <Viewbox Width="11" Height="11"><Path Data="{StaticResource IconX}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/></Viewbox>
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CategoryRail}"
                                      ItemTemplate="{StaticResource CategoryRowTemplate}"
                                      Margin="8,0,8,10"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ─── PRODUCTS ─── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0.5" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="38"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0.5" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="14" Height="14" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextTertiaryBrush}" Stretch="Fill"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="SearchPlaceholderTb"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource StringToVis}}"/>
                                <TextBox Grid.Column="1" x:Name="ProductSearchBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Background="Transparent" BorderThickness="0"
                                         Padding="0,0,12,0" VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding ResultCountLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,4,0"/>
                    </Grid>

                    <!-- List / empty state -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ProductsListBox"
                                 ItemsSource="{Binding Products}"
                                 SelectedItem="{Binding SelectedProduct}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource ProductRowItemStyle}"
                                 ItemTemplate="{StaticResource ProductRowTemplate}"
                                 MouseDoubleClick="ProductsListBox_MouseDoubleClick"
                                 Visibility="{Binding IsEmptyResult, Converter={StaticResource InvBoolVis}}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260"
                                    Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="34" Height="34" Opacity="0.3" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconProducts}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/>
                            </Viewbox>
                            <TextBlock x:Name="EmptyTitleTb" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock x:Name="EmptySubtitleTb" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── DETAIL / ACTIVITY PANEL ─── -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0.5" CornerRadius="10">
                <DockPanel>

                    <!-- Top: selection summary OR placeholder -->
                    <Grid DockPanel.Dock="Top">
                        <!-- No selection -->
                        <StackPanel Margin="16,26,16,20" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InvBoolVis}}">
                            <Viewbox Width="30" Height="30" Opacity="0.3" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconTag}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Fill"/>
                            </Viewbox>
                            <TextBlock x:Name="NoSelectionHintTb" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- Selection summary -->
                        <StackPanel Margin="16,16,16,14"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10"
                                        Background="{DynamicResource AccentLightBrush}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedProduct.Name, Converter={StaticResource ToInitials}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedProduct.ImagePath, Converter={StaticResource NoImageVis}}"/>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding SelectedProduct.ImagePath, Converter={StaticResource FileToImg}}"
                                               Visibility="{Binding SelectedProduct.ImagePath, Converter={StaticResource HasImageVis}}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0.5"
                                                CornerRadius="9" Padding="8,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedProduct.CategoryName}" FontSize="10" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="8,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProduct.IsActive}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedProduct.IsActive, Converter={StaticResource ActiveStatusLabel}}"
                                                       FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedProduct.IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Stat tiles -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="8" Padding="11,9">
                                    <StackPanel>
                                        <TextBlock x:Name="PriceTileLabelTb" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedProduct.Price, Converter={StaticResource Digits}, ConverterParameter=N2}"
                                                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="8" Padding="11,9">
                                    <StackPanel>
                                        <TextBlock x:Name="StockTileLabelTb" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedProduct.QuantityOnHand, Converter={StaticResource Digits}, ConverterParameter=N0}"
                                                   FontSize="15" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProduct.IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Quick actions -->
                            <Button x:Name="EditProductBtn" Style="{StaticResource AccentButton}" Margin="0,12,0,0"
                                    Command="{Binding EditProductCommand}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                        Command="{Binding ToggleActiveCommand}"
                                        Content="{Binding SelectedProduct.IsActive, Converter={StaticResource ActiveToggleLabel}}"/>
                                <Button x:Name="DeleteProductBtn" Grid.Column="2" Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteProductCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0.5,0,0"/>

                    <!-- Activity feed -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                        <TextBlock x:Name="ActivityHeaderTb" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StockHistoryStatus}" FontSize="10.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Grid>
                        <TextBlock x:Name="NoActivityTb" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoActivity, Converter={StaticResource BoolToVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasNoActivity, Converter={StaticResource InvBoolVis}}">
                            <ItemsControl ItemsSource="{Binding StockMovements}"
                                          ItemTemplate="{StaticResource ActivityRowTemplate}"
                                          Margin="16,0,16,12"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
