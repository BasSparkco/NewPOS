<Window x:Class="POS.Wpf.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product"
        Height="720" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{StaticResource BgPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource PosTextBox}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="Margin"          Value="0,4,0,20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog header -->
        <StackPanel Grid.Row="0" Margin="24,22,24,6">
            <TextBlock x:Name="DialogTitleTb"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="DialogSubtitleTb"
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,4">
            <StackPanel>

                <!-- Image -->
                <Grid Margin="0,6,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="14"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0.5"
                            ClipToBounds="True">
                        <Grid>
                            <StackPanel x:Name="NoImagePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24" Opacity="0.4" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconProducts}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Fill"/>
                                </Viewbox>
                                <TextBlock x:Name="PeNoImageTb" FontSize="8.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Image x:Name="ProductImagePreview" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="PeImageLbl" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="PeBrowseBtn"
                                Click="BrowseImage_Click"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Padding="16,7"
                                Margin="0,4,0,6"/>
                        <Button x:Name="PeClearBtn"
                                Click="ClearImage_Click"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"
                                Padding="16,7"/>
                    </StackPanel>
                </Grid>

                <!-- Basic info -->
                <TextBlock x:Name="SectionBasicTb" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="PeNameLbl" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>

                <TextBlock x:Name="PeBarcodeLbl" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BarcodeBox" Style="{StaticResource Field}"/>

                <TextBlock x:Name="PeCategoryLbl" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,4"
                          Padding="9,7"
                          FontSize="12"/>

                <Border Style="{StaticResource SectionDivider}"/>

                <!-- Pricing -->
                <TextBlock x:Name="SectionPricingTb" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PePriceLbl" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource PosTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="PeCostLbl" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CostBox" Style="{StaticResource PosTextBox}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SectionDivider}"/>

                <!-- Inventory -->
                <TextBlock x:Name="SectionInventoryTb" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="PeStockLbl" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="StockBox" Style="{StaticResource Field}" Margin="0,0,0,4"/>

                <Border Style="{StaticResource SectionDivider}"/>

                <!-- Status -->
                <TextBlock x:Name="SectionStatusTb" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ActiveToggle" Grid.Column="0"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" IsChecked="True"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeActiveLbl" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PeActiveHelpTb" FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel LastChildFill="False">
                <Button x:Name="PeCancelBtn"
                        DockPanel.Dock="Left"
                        Click="Cancel_Click"
                        Style="{StaticResource GhostButton}"
                        Width="90"/>
                <Button x:Name="PeSaveBtn"
                        DockPanel.Dock="Right"
                        Click="Ok_Click"
                        Style="{StaticResource AccentButton}"
                        Width="120"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
