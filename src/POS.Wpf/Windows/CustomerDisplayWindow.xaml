<Window x:Class="POS.Wpf.Windows.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Display — SmartPOS"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111827"
        Width="480" Height="360"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1F2937"
                Padding="20,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           FontSize="16" FontWeight="SemiBold">
                    <Run Text="Smart" Foreground="White"/>
                    <Run Text="POS" Foreground="#10B981"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right"
                           x:Name="TimeText"
                           FontSize="13"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Column header — mirrors the row grid below: Product/Price/Qty/Sum, always visible -->
        <Border Grid.Row="1"
                Background="#1F2937"
                BorderBrush="#374151"
                BorderThickness="0,0,0,0.5"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="HeaderProductTb"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                <TextBlock Grid.Column="1" x:Name="HeaderPriceTb"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" x:Name="HeaderQtyTb"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" x:Name="HeaderSumTb"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Cart area -->
        <Grid Grid.Row="2">

            <!-- Idle / no items -->
            <StackPanel x:Name="IdlePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="CdWelcomeTb"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="CdSubtitleTb"
                           FontSize="13"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Items list -->
            <ItemsControl x:Name="LinesList"
                          Visibility="Collapsed"
                          Margin="0,0,0,0">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#374151"
                                BorderThickness="0,0,0,0.5"
                                Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name only — no secondary line, so the eye lands on Price/Qty/Sum -->
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <!-- Unit price actually charged (already net of any discount) -->
                                <TextBlock Grid.Column="1" Text="{Binding PriceText}"
                                           FontSize="15"
                                           Foreground="#D1D5DB"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>

                                <!-- Qty value only — no +/- controls, those are cashier-only -->
                                <TextBlock Grid.Column="3" Text="{Binding QtyText}"
                                           FontSize="15"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Line total -->
                                <TextBlock Grid.Column="5" Text="{Binding SumText}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

        <!-- Totals footer: Subtotal/VAT rows only appear when VAT is added on top of the
             subtotal (PricesIncludeVat = false) — otherwise the customer sees just the Total. -->
        <Border Grid.Row="3"
                Background="#1F2937"
                Padding="20,12">
            <StackPanel>
                <DockPanel x:Name="SubtotalRow" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock x:Name="CdSubtotalLabelTb"
                               DockPanel.Dock="Left"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                    <TextBlock x:Name="SubtotalText"
                               DockPanel.Dock="Right"
                               FontSize="12"
                               Foreground="#D1D5DB"/>
                </DockPanel>
                <DockPanel x:Name="VatRow" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock x:Name="CdVatLabelTb"
                               DockPanel.Dock="Left"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                    <TextBlock x:Name="VatText"
                               DockPanel.Dock="Right"
                               FontSize="12"
                               Foreground="#D1D5DB"/>
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="CdTotalLabelTb"
                               DockPanel.Dock="Left"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               x:Name="TotalText"
                               Text="0.00"
                               FontSize="30" FontWeight="Bold"
                               Foreground="#10B981"/>
                </DockPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
